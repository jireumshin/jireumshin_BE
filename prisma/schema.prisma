generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL // 이메일/비밀번호 가입
  KAKAO // 카카오 소셜 로그인
}

model User {
  id         String       @id @default(cuid())
  email      String?      @unique // 로그인 ID (카카오는 이메일 동의를 거부할 수 있어 nullable)
  nickname   String       @unique // 표시 이름
  password   String? // bcrypt 해시 (카카오 로그인은 없음)
  provider   AuthProvider @default(LOCAL) // 최초 가입 경로
  providerId String?      @unique // 카카오 고유 id (LOCAL 계정에 연동돼도 채워짐)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  resetTokens PasswordResetToken[]
  trials      Trial[] // 내가 기소한 사건(판례)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String // 토큰 원문은 저장하지 않고 해시만 보관
  expiresAt DateTime
  usedAt    DateTime? // 사용되면 기록 (재사용 방지)
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum TrialStatus {
  PENDING // 심리 중
  JUDGED // 판결 완료
}

enum Verdict {
  GUILTY // 유죄 = 사지 마
  NOT_GUILTY // 무죄 = 사도 됨
}

model Trial {
  id        String      @id @default(cuid())
  itemName  String
  price     Int
  reason    String?
  imageUrl  String?
  status    TrialStatus @default(PENDING)
  verdict   Verdict? // 최종 판결 (다수결)
  summary   String? // 판결 요지
  regretIndex Int? // 예상 후회지수 (0~100)
  jury      Json? // 배심원 4명 평결 [{ juror, emoji, vote, argument }]
  userId    String? // 기소한 유저(비로그인 익명 기소는 null)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}
