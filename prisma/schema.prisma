generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL // 이메일/비밀번호 가입
  KAKAO // 카카오 소셜 로그인
}

model User {
  id         String       @id @default(cuid())
  email      String?      @unique // 로그인 ID (카카오는 이메일 동의를 거부할 수 있어 nullable)
  nickname   String       @unique // 표시 이름
  password   String? // bcrypt 해시 (카카오 로그인은 없음)
  provider   AuthProvider @default(LOCAL) // 최초 가입 경로
  providerId String?      @unique // 카카오 고유 id (LOCAL 계정에 연동돼도 채워짐)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  resetTokens PasswordResetToken[]
  trials      Trial[] // 내가 기소한 사건(판례)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String // 토큰 원문은 저장하지 않고 해시만 보관
  expiresAt DateTime
  usedAt    DateTime? // 사용되면 기록 (재사용 방지)
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum TrialStatus {
  PENDING // 심리 중
  JUDGED // 판결 완료
}

enum Verdict {
  GUILTY // 유죄 = 사지 마
  NOT_GUILTY // 무죄 = 사도 됨
}

enum MessageRole {
  USER // 피고인(사용자)의 변론
  JUROR // 배심원의 반응
}

enum TrialMode {
  SINGLE // 한 물건 살까/말까 (1차)
  VERSUS // 두 물건 A vs B 비교 (2차)
}

enum VersusResult {
  A // A 물건 승 (이걸 사라)
  B // B 물건 승 (이걸 사라)
  NEITHER // 둘 다 별로 (지금은 사지 마)
}

model Trial {
  id        String      @id @default(cuid())
  itemName  String
  price     Int
  reason    String?
  imageUrl  String?
  status    TrialStatus @default(PENDING)
  mode      TrialMode   @default(SINGLE) // SINGLE=살까말까, VERSUS=A vs B 비교
  verdict   Verdict? // 최종 판결 (다수결, SINGLE 모드)
  summary   String? // 판결 요지
  regretIndex Int? // 예상 후회지수 (0~100)
  jury      Json? // 배심원 4명 평결 [{ juror, emoji, vote, argument }]
  userId    String? // 기소한 유저(비로그인 익명 기소는 null)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  // 후회 추적 (판결 후 일정 시간 뒤 재질문)
  followUpDueAt      DateTime? // 재질문이 열리는 시점 (판결 시각 + 지연)
  followUpNotifiedAt DateTime? // 재질문 알림(메일) 발송 시각 (null = 미발송)
  followedUpAt       DateTime? // 재질문에 응답한 시각 (null = 미응답)
  purchased          Boolean? // 결국 샀는지
  regret             Boolean? // 후회하는지 (핵심 신호)
  // 배심원 변론(설득) 게임 — 판결 후 사용자가 배심원을 설득해 표를 뒤집는다
  gauges        Json?          // 배심원별 설득 게이지 { juror: 0~100 } (null = 변론 시작 전)
  defenseRounds Int      @default(0) // 사용한 변론 라운드 수
  defenseClosed Boolean  @default(false) // 라운드 소진 후 변론 종료(판결 확정)
  messages      TrialMessage[] // 변론 대화 로그
  // ── A vs B 비교 재판 (VERSUS 모드) — B 물건과 비교 결과. SINGLE이면 모두 null ──
  itemNameB    String? // 비교 대상 B 물건
  priceB       Int?
  reasonB      String?
  imageUrlB    String?
  versusResult VersusResult? // A | B | NEITHER (둘 다 별로)
  juryB        Json? // B 물건 배심원 평결 (A는 jury 재사용)
  gaugesB      Json? // B 물건 배심원 게이지 (A는 gauges 재사용)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model TrialMessage {
  id        String      @id @default(cuid())
  trialId   String
  trial     Trial       @relation(fields: [trialId], references: [id], onDelete: Cascade)
  role      MessageRole
  juror     String? // JUROR일 때 어느 배심원인지
  emoji     String? // JUROR일 때 배심원 이모지
  content   String
  round     Int // 몇 번째 변론 라운드에서 나온 메시지인지
  target    String? // VERSUS 변론에서 편든 물건 ("A" | "B"), SINGLE이면 null
  createdAt DateTime    @default(now())

  @@index([trialId])
}
